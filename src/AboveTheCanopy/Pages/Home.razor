@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Above the Canopy: Leadership, Management &amp; Teams</PageTitle>

<div class="app">
    <header class="top">
        <div>
            <h1>🌳 Above the Canopy</h1>
            <p class="tagline">An interactive story about <b class="c-leader">leadership</b> (the eagle), <b class="c-manager">management</b> (the owl) and <b class="c-team">team members</b> (the koalas). Who sees what?</p>
        </div>
        <div class="stats">
            <span class="day" title="Project time: 1 project day = 2 seconds of animation at 1× speed">📅 Day @day</span>
            <span title="Planned obstacles the koalas hit without a warning from the Manager">⚠️ Unwarned obstacles: @surprises</span>
            <span title="Times the koalas had to back-track">↩ Wrong turns: @wrongTurns</span>
            <span title="Leader and Manager distractions shaken off">🧘 Distractions handled: @distractions</span>
            <span title="Competing priorities the Leader parked or declined in meetings">🗂️ Priorities filtered: @priorities</span>
            <span title="Unexpected events the koalas reported up the chain to the Leader">📣 Surprises reported up: @reported</span>
            <span title="Manager-to-manager meetings under the canopy: sharing resources, status syncs, coordinating teams">🤝 Manager syncs: @syncs</span>
            <span title="Ideas from the koalas that travelled up the chain and were adopted by the Leader">💡 Team ideas adopted: @ideas</span>
        </div>
    </header>

    <div class="stage">
        <canvas @ref="canvas" class="scene" aria-label="Animated forest scene showing a leader, a manager and a team"></canvas>

        @if (selected is not null)
        {
            <div class="info-card role-@selected.Key" role="dialog" aria-label="@selected.Title">
                <button class="close" @onclick="CloseCard" aria-label="Close">✕</button>
                <h2>@selected.Emoji @selected.Title</h2>
                <p class="theme">@selected.Theme</p>
                <div class="info-body" tabindex="0" aria-label="Role details (scrollable)">
                    <p><b>What they see:</b> @selected.Sees</p>
                    <ul>
                        @foreach (var d in selected.Does)
                        {
                            <li>@d</li>
                        }
                    </ul>
                    <p class="takeaway">💡 @selected.Takeaway</p>
                </div>
            </div>
        }

        @if (finishedSummary is not null)
        {
            <div class="summary" tabindex="0">
                @if (!showReflection)
                {
                    <h2>🎉 Delivered in @lastDays days!</h2>
                    <p>@finishedSummary</p>
                    <div class="row">
                        <button class="reflect" @onclick="() => showReflection = true">💬 Reflect</button>
                        <button @onclick="Restart">↻ Play again</button>
                        <button @onclick="RestartWithOtherComms">@(comms ? "Try with communication OFF" : "Try with communication ON")</button>
                        <button class="ghost" @onclick="() => finishedSummary = null">Close</button>
                    </div>
                }
                else
                {
                    <h2>💬 Reflection</h2>
                    <p class="reflect-intro">Three questions to talk about. How does this run compare with your workplace?</p>
                    <ol class="reflection">
                        @foreach (var q in reflection)
                        {
                            <li>@q</li>
                        }
                    </ol>
                    <div class="row">
                        <button @onclick="() => showReflection = false">← Back</button>
                        <button @onclick="RestartWithOtherComms">@(comms ? "↻ Try with comms OFF" : "↻ Try with comms ON")</button>
                    </div>
                }
            </div>
        }
    </div>

    <div class="caption" aria-live="polite">
        <span class="phase @PhaseClass">@phase</span>
        <span>@caption</span>
    </div>

    <div class="controls">
        <div class="group">
            <button class="primary" @onclick="TogglePlay">@(playing ? "⏸ Pause" : "▶ Play")</button>
            <button @onclick="Restart">↻ Restart</button>
            <label class="speed">Speed
                <input type="range" min="0.25" max="3" step="0.25" value="@speed" @oninput="OnSpeed" />
                <span>@speed.ToString("0.##")×</span>
            </label>
        </div>

        <div class="group views" role="group" aria-label="Perspective">
            <span class="label">Perspective:</span>
            @foreach (var v in views)
            {
                <button class="view @(view == v.Key ? "active" : "") v-@v.Key" @onclick="() => SetView(v.Key)" title="@v.Hint">@v.Label</button>
            }
        </div>

        <div class="group">
            <label class="switch" title="When OFF, the manager still sees obstacles but never tells the team.">
                <input type="checkbox" checked="@comms" @onchange="OnComms" />
                <span class="slider"></span>
                <span>Manager communication <b>@(comms ? "ON" : "OFF")</b></span>
            </label>
        </div>
    </div>

    <section class="roles">
        @foreach (var r in new[] { Roles.Leader, Roles.Manager, Roles.Team })
        {
            <button class="role-chip role-@r.Key" @onclick="() => Select(r.Key)">
                <span class="emoji">@r.Emoji</span>
                <span><b>@r.Title</b><br /><small>@r.Theme</small></span>
            </button>
        }
    </section>

    <footer class="hint">Tip: click the eagle, the owl, the koalas or the pyramid to learn about each role. Keys: <kbd>Space</kbd> play/pause, <kbd>R</kbd> restart, <kbd>1</kbd>–<kbd>4</kbd> perspectives.</footer>
</div>

@code {
    private ElementReference canvas;
    private IJSObjectReference? module;
    private DotNetObjectReference<Home>? selfRef;

    private bool playing = true;
    private double speed = 1;
    private string view = "all";
    private bool comms = true;
    private string caption = "Loading the forest...";
    private string phase = "";
    private RoleInfo? selected;
    private int wrongTurns, surprises, distractions, priorities, reported, syncs, ideas, day = 1, lastDays;
    private bool showReflection;
    private string[] reflection = Array.Empty<string>();
    private int? daysOn, daysOff; // results from this session, for the ON vs OFF comparison
    private const int TypicalDaysOn = 119, TypicalDaysOff = 154; // measured at 1x, see README
    private string PhaseClass => phase switch
    {
        "SURPRISE" => "ph-surprise", "Meeting" or "Priorities" or "Focus" => "ph-meeting", "Distraction" or "Refocus" => "ph-distraction",
        "Manager meeting" => "ph-mgr", "Goal reached" => "ph-goal", "LEADER SUPPORT" => "ph-support",
        "COACHING" or "DELEGATION" or "RECOGNITION" => "ph-grow", "TEAM IDEA" or "COURSE CORRECTION" => "ph-idea", "WELLBEING" => "ph-well", _ => ""
    };
    private string? finishedSummary;

    private sealed record ViewOption(string Key, string Label, string Hint);
    private static readonly ViewOption[] views =
    {
        new("all", "👁 Everything", "Show the whole scene"),
        new("leader", "🦅 Leader", "Only what the leader can see from above the canopy"),
        new("manager", "🦉 Manager", "Only what the manager can see below the canopy"),
        new("team", "🐨 Team", "Only what the koalas can see on the forest floor"),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canopy.js");
        selfRef = DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("init", canvas, selfRef);
    }

    private ValueTask Js(string fn, params object?[] args) => module is null ? ValueTask.CompletedTask : module.InvokeVoidAsync(fn, args);

    private async Task TogglePlay() { playing = !playing; await Js("setPlaying", playing); }

    private async Task Restart()
    {
        finishedSummary = null; showReflection = false; ResetCounters();
        await Js("restart");
        if (!playing) { playing = true; await Js("setPlaying", true); }
    }

    private async Task RestartWithOtherComms()
    {
        comms = !comms;
        await Js("setComms", comms);
        await Restart();
    }

    private async Task OnSpeed(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            speed = v;
            await Js("setSpeed", v);
        }
    }

    private async Task SetView(string v) { view = v; await Js("setView", v); }

    private async Task OnComms(ChangeEventArgs e)
    {
        comms = e.Value is bool b && b;
        await Js("setComms", comms);
    }

    private async Task Select(string key) { selected = Roles.Get(key); await Js("select", key); }
    private async Task CloseCard() { selected = null; await Js("select", ""); }

    // ---- callbacks from the JS engine ----
    [JSInvokable] public void OnCaption(string text, string ph) { caption = text; phase = ph; StateHasChanged(); }
    [JSInvokable] public void OnAgentClicked(string role) { selected = Roles.Get(role); StateHasChanged(); }
    [JSInvokable] public void OnPlayState(bool isPlaying) { playing = isPlaying; StateHasChanged(); }
    [JSInvokable] public void OnViewChanged(string v) { view = v; StateHasChanged(); }
    private void ResetCounters() { wrongTurns = 0; surprises = 0; distractions = 0; priorities = 0; reported = 0; syncs = 0; ideas = 0; day = 1; }
    [JSInvokable] public void OnRestarted() { finishedSummary = null; showReflection = false; ResetCounters(); StateHasChanged(); }
    [JSInvokable] public void OnDay(int d) { day = d; StateHasChanged(); }
    [JSInvokable] public void OnStats(int wrong, int surprised, int distracted, int filtered, int reportedUp, int managerSyncs, int teamIdeas) { wrongTurns = wrong; surprises = surprised; distractions = distracted; priorities = filtered; reported = reportedUp; syncs = managerSyncs; ideas = teamIdeas; StateHasChanged(); }

    [JSInvokable]
    public void OnFinished(int seconds, int days, int wrong, int surprised, int distracted, int filtered, int reportedUp, int managerSyncs, int teamIdeas, int breaks, bool withComms)
    {
        wrongTurns = wrong; surprises = surprised; distractions = distracted; priorities = filtered; reported = reportedUp; syncs = managerSyncs; ideas = teamIdeas;
        showReflection = false;
        day = days; lastDays = days;
        if (withComms) daysOn = days; else daysOff = days;
        var mins = seconds / 60; var secs = seconds % 60;
        var runTime = $"({mins}:{secs:00} at 1× speed)";
        string compare;
        if (withComms)
        {
            var off = daysOff ?? TypicalDaysOff;
            var src = daysOff is null ? "usually takes about" : "took";
            compare = off > days
                ? $" Without communication the same project {src} {off} days: {off - days} days lost. Try it with communication OFF and compare!"
                : " Try it with communication OFF and compare!";
        }
        else
        {
            var on = daysOn ?? TypicalDaysOn;
            var src = daysOn is null ? "usually takes about" : "took";
            compare = days > on
                ? $" With the Manager communicating, the same project {src} {on} days: that's {days - on} days lost to missing information."
                : "";
        }
        var people = withComms
            ? $" Kip led the bridge build, Wattle was coached, Matilda was Koala of the week, Banjo's creek idea was adopted ({teamIdeas} team idea{(teamIdeas == 1 ? "" : "s")}), and {breaks} short break{(breaks == 1 ? "" : "s")} kept the pace sustainable."
            : " Banjo's shortcut never reached the Leader, nobody coached Wattle, and with no break the koalas finished exhausted.";
        finishedSummary = withComms
            ? $"With the Manager communicating, the koalas delivered on day {days} {runTime}: {surprised} unwarned obstacles, {wrong} wrong turns and {reportedUp} surprises reported up and handled together. The Leader filtered {filtered} competing priorities, the Manager held {managerSyncs} manager syncs, and they shook off {distracted} distractions.{people}{compare}"
            : $"Without communication, the koalas took {days} days {runTime}, hit {surprised} unwarned obstacles, made {wrong} wrong turns, and faced every surprise alone (0 reported up).{people}{compare} Same forest, same koalas: the difference is the information they had.";
        reflection = withComms
            ? new[]
            {
                "Banjo spotted the creek shortcut from the ground and the Leader changed the plan. How do ideas from the front line reach decision-makers where you work, and how often do they change the plan?",
                "The owl coached Wattle one-to-one and handed Kip the lead on the bridge. Who are you growing right now, and what could you delegate this week?",
                "The Leader said yes to saws and safety gear, protected the team's time from the Board, and the koalas still took a break. What does backing your team look like in practice?"
            }
            : new[]
            {
                "Banjo's shortcut went nowhere because nobody passed it up. Which good ideas get lost in your team, and why?",
                "Nobody noticed Wattle struggling. How would you know if someone in your team needed help?",
                "The koalas never got a break and slowed right down. Where is your team running without breaks, and what is it costing?"
            };
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module is not null)
            {
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        selfRef?.Dispose();
    }
}
