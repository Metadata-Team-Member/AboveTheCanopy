@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Above the Canopy: Leadership, Management &amp; Teams</PageTitle>

<div class="app">
    <header class="top">
        <div>
            <h1>🌳 Above the Canopy</h1>
            <p class="tagline">An interactive story about <b class="c-leader">leadership</b> (the eagle), <b class="c-manager">management</b> (the owl) and <b class="c-team">team members</b> (the koalas). Who sees what?</p>
        </div>
        <div class="stats">
            <span class="day" title="Project time: 1 project day = 2 seconds of animation at 1× speed">📅 Day @day</span>
            <span title="Planned obstacles the koalas hit without a warning from the Manager">⚠️ Unwarned obstacles: @surprises</span>
            <span title="Times the koalas had to back-track">↩ Wrong turns: @wrongTurns</span>
            <span title="Leader and Manager distractions shaken off">🧘 Distractions handled: @distractions</span>
            <span title="Competing priorities the Leader parked or declined in meetings">🗂️ Priorities filtered: @priorities</span>
            <span title="Unexpected events the koalas reported up the chain to the Leader">📣 Surprises reported up: @reported</span>
            <span title="Manager-to-manager meetings under the canopy: sharing resources, status syncs, coordinating teams">🤝 Manager syncs: @syncs</span>
            <span title="Ideas from the koalas that travelled up the chain and were adopted by the Leader">💡 Team ideas adopted: @ideas</span>
        </div>
    </header>

    <div class="stage">
        <canvas @ref="canvas" class="scene" aria-label="Animated forest scene showing a leader, a manager and a team"></canvas>

        @if (selected is not null)
        {
            <div class="info-card role-@selected.Key" role="dialog" aria-label="@selected.Title">
                <button class="close" @onclick="CloseCard" aria-label="Close">✕</button>
                <h2>@selected.Emoji @selected.Title</h2>
                <p class="theme">@selected.Theme</p>
                <div class="info-body" tabindex="0" aria-label="Role details (scrollable)">
                    <p><b>What they see:</b> @selected.Sees</p>
                    <ul>
                        @foreach (var d in selected.Does)
                        {
                            <li>@d</li>
                        }
                    </ul>
                    <p class="takeaway">💡 @selected.Takeaway</p>
                </div>
            </div>
        }

        @if (teachCard is int tc)
        {
            var tch = Chapters.All[tc];
            <div class="teach-card" role="dialog" aria-label="Teachable moment">
                <div class="teach-kicker">🎓 Teachable moment · Chapter @(tc + 1) of @Chapters.All.Count</div>
                <h2>@tch.Title</h2>
                <p class="teach-point">@(comms ? tch.Point : tch.OffPoint ?? tch.Point)</p>
                <ul class="teach-q">
                    @foreach (var q in tch.Questions)
                    {
                        <li>💬 @q</li>
                    }
                </ul>
                <div class="row">
                    <button class="primary" @onclick="ContinueFromTeach">▶ Continue</button>
                    <button class="ghost" @onclick="StopTeaching">Stop pausing</button>
                </div>
            </div>
        }

        @if (finishedSummary is not null)
        {
            <div class="summary" tabindex="0">
                @if (!showReflection)
                {
                    <h2>🎉 Pyramid built in @lastDays days!</h2>
                    <p>@finishedSummary</p>
                    <div class="row">
                        <button class="reflect" @onclick="() => showReflection = true">💬 Reflect</button>
                        <button @onclick="Restart">↻ Play again</button>
                        <button @onclick="RestartWithOtherComms">@(comms ? "Try with communication OFF" : "Try with communication ON")</button>
                        <button class="ghost" @onclick="() => finishedSummary = null">Close</button>
                    </div>
                }
                else
                {
                    <h2>💬 Reflection</h2>
                    <p class="reflect-intro">Three questions to talk about. How does this run compare with your workplace?</p>
                    <ol class="reflection">
                        @foreach (var q in reflection)
                        {
                            <li>@q</li>
                        }
                    </ol>
                    <div class="row">
                        <button @onclick="() => showReflection = false">← Back</button>
                        <button @onclick="RestartWithOtherComms">@(comms ? "↻ Try with comms OFF" : "↻ Try with comms ON")</button>
                    </div>
                }
            </div>
        }
    </div>

    <div class="caption" aria-live="polite">
        <span class="phase @PhaseClass">@phase</span>
        <span>@caption</span>
    </div>

    <div class="controls">
        <div class="group">
            <button class="primary" @onclick="TogglePlay">@(playing ? "⏸ Pause" : "▶ Play")</button>
            <button @onclick="Restart">↻ Restart</button>
            <label class="speed">Speed
                <input type="range" min="0.25" max="3" step="0.25" value="@speed" @oninput="OnSpeed" />
                <span>@speed.ToString("0.##")×</span>
            </label>
        </div>

        <div class="group views" role="group" aria-label="Perspective">
            <span class="label">Perspective:</span>
            @foreach (var v in views)
            {
                <button class="view @(view == v.Key ? "active" : "") v-@v.Key" @onclick="() => SetView(v.Key)" title="@v.Hint">@v.Label</button>
            }
        </div>

        <div class="group">
            <label class="switch" title="When OFF, the manager still sees obstacles but never tells the team.">
                <input type="checkbox" checked="@comms" @onchange="OnComms" />
                <span class="slider"></span>
                <span>Manager communication <b>@(comms ? "ON" : "OFF")</b></span>
            </label>
        </div>

        <div class="group chapters-group">
            <button class="chapters-btn" @onclick="ToggleChapters" aria-expanded="@(showChapters ? "true" : "false")" title="Chapters (C) · next chapter (N)">📖 <span class="ch-name">Chapter @(chapter + 1)/@Chapters.All.Count: @Chapters.All[chapter].Title</span></button>
            <button class="next-ch" @onclick="NextChapter" disabled="@(chapter + 1 >= Chapters.All.Count)" title="Next chapter (N)" aria-label="Next chapter">⏭</button>
            <button class="toggle teach @(teach ? "active" : "")" aria-pressed="@(teach ? "true" : "false")" @onclick="ToggleTeach" title="Teaching mode: pause at the start of each chapter with a teachable moment">🎓 Pause at chapters</button>
        </div>

        <div class="group sound">
            <button data-sound-toggle class="toggle sound-btn @(soundOn ? "active" : "")" aria-pressed="@(soundOn ? "true" : "false")" @onclick="ToggleSound" title="Sound on/off (M)">@(soundOn ? "🔊 Sound on" : "🔇 Sound off")</button>
            <input type="range" class="volume" min="0" max="1" step="0.05" value="@volume" @oninput="OnVolume" aria-label="Volume" title="Volume" disabled="@(!soundOn)" />
        </div>
    </div>

    @if (showChapters)
    {
        <div class="chapters-backdrop" @onclick="() => showChapters = false"></div>
        <aside class="chapters" role="dialog" aria-label="Chapters">
            <div class="chapters-head">
                <h2>📖 Chapters</h2>
                <button class="close" @onclick="() => showChapters = false" aria-label="Close chapters">✕</button>
            </div>
            <label class="switch teach-switch">
                <input type="checkbox" checked="@teach" @onchange="OnTeach" />
                <span class="slider"></span>
                <span>Pause at each chapter <small>(teaching mode)</small></span>
            </label>
            <p class="chapters-hint">Tap a chapter to jump straight to it. Keys: <kbd>C</kbd> chapters, <kbd>N</kbd> next chapter.</p>
            <ol class="chapter-list">
                @for (var i = 0; i < Chapters.All.Count; i++)
                {
                    var idx = i; var c = Chapters.All[i];
                    <li>
                        <button class="chapter @(idx == chapter ? "current" : "")" @onclick="() => JumpTo(idx)" aria-current="@(idx == chapter ? "step" : null)">
                            <span class="num">@(idx + 1)</span>
                            <span class="txt"><b>@c.Title</b><small>@(comms ? c.Point : c.OffPoint ?? c.Point)</small></span>
                        </button>
                    </li>
                }
            </ol>
        </aside>
    }

    <section class="roles">
        @foreach (var r in new[] { Roles.Leader, Roles.Manager, Roles.Team })
        {
            <button class="role-chip role-@r.Key" @onclick="() => Select(r.Key)">
                <span class="emoji">@r.Emoji</span>
                <span><b>@r.Title</b><br /><small>@r.Theme</small></span>
            </button>
        }
    </section>

    <footer class="hint">Tip: click the eagle, the owl, the koalas or the pyramid (the vision) to learn about each role. Keys: <kbd>Space</kbd> play/pause, <kbd>R</kbd> restart, <kbd>1</kbd>–<kbd>4</kbd> perspectives, <kbd>C</kbd> chapters, <kbd>N</kbd> next chapter, <kbd>M</kbd> sound on/off.
        <span class="licence">© 2026 Metadata-Team-Member · <a href="https://github.com/Metadata-Team-Member/AboveTheCanopy/blob/main/LICENSE">MIT licence</a></span></footer>
</div>

@code {
    private ElementReference canvas;
    private IJSObjectReference? module;
    private DotNetObjectReference<Home>? selfRef;

    private bool playing = true;
    private double speed = 1;
    private string view = "all";
    private bool comms = true;
    private string caption = "Loading the forest...";
    private string phase = "";
    private RoleInfo? selected;
    private int wrongTurns, surprises, distractions, priorities, reported, syncs, ideas, day = 1, lastDays;
    private bool showReflection;
    private int chapter;
    private bool showChapters, teach, soundOn = true;
    private int? teachCard;
    private double volume = 0.6;
    private sealed record SoundPrefs(bool enabled, double volume);
    private string[] reflection = Array.Empty<string>();
    private int? daysOn, daysOff; // results from this session, for the ON vs OFF comparison
    private const int TypicalDaysOn = 152, TypicalDaysOff = 198; // measured at 1x, see README
    private string PhaseClass => phase switch
    {
        "SURPRISE" => "ph-surprise", "Meeting" or "Priorities" or "Focus" => "ph-meeting", "Distraction" or "Refocus" => "ph-distraction",
        "Manager meeting" => "ph-mgr", "Goal reached" => "ph-goal", "LEADER SUPPORT" => "ph-support",
        "COACHING" or "DELEGATION" or "RECOGNITION" or "SUPPORT" or "TEAMWORK" => "ph-grow", "BUILD" => "ph-build", "VISION → REALITY" => "ph-vision", "REDO" => "ph-surprise", "TEAM IDEA" or "COURSE CORRECTION" => "ph-idea", "WELLBEING" => "ph-well", _ => ""
    };
    private string? finishedSummary;

    private sealed record ViewOption(string Key, string Label, string Hint);
    private static readonly ViewOption[] views =
    {
        new("all", "👁 Everything", "Show the whole scene"),
        new("leader", "🦅 Leader", "Only what the leader can see from above the canopy"),
        new("manager", "🦉 Manager", "Only what the manager can see below the canopy"),
        new("team", "🐨 Team", "Only what the koalas can see on the forest floor"),
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canopy.js");
        selfRef = DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("init", canvas, selfRef);
        await module.InvokeVoidAsync("setChapters", (object)Chapters.Marks);
        try
        {
            var prefs = await module.InvokeAsync<SoundPrefs>("soundPrefs");
            soundOn = prefs.enabled; volume = prefs.volume;
        }
        catch (JSException) { }
        StateHasChanged();
    }

    private ValueTask Js(string fn, params object?[] args) => module is null ? ValueTask.CompletedTask : module.InvokeVoidAsync(fn, args);

    private async Task TogglePlay() { playing = !playing; teachCard = null; await Js("setPlaying", playing); }

    // ---- v6: chapters and teaching mode ----
    private void ToggleChapters() => showChapters = !showChapters;
    private async Task ToggleTeach() { teach = !teach; await Js("setTeach", teach); }
    private async Task OnTeach(ChangeEventArgs e) { teach = e.Value is bool b && b; await Js("setTeach", teach); }
    private async Task JumpTo(int i)
    {
        if (module is null) return;
        showChapters = false; teachCard = null; finishedSummary = null; showReflection = false; ResetCounters();
        chapter = await module.InvokeAsync<int>("jumpTo", i);
        if (teach && Chapters.All[chapter].Mark != "finish")
        {
            teachCard = chapter; playing = false; await Js("setPlaying", false);
        }
        else if (!playing) { playing = true; await Js("setPlaying", true); }
    }
    private async Task NextChapter() { if (chapter + 1 < Chapters.All.Count) await JumpTo(chapter + 1); }
    private async Task ContinueFromTeach() { teachCard = null; playing = true; await Js("setPlaying", true); }
    private async Task StopTeaching() { teach = false; await Js("setTeach", false); await ContinueFromTeach(); }

    // ---- v6: sound ----
    private async Task ToggleSound() { soundOn = !soundOn; await Js("setSound", soundOn); }
    private async Task OnVolume(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            volume = v; await Js("setVolume", v);
        }
    }

    private async Task Restart()
    {
        finishedSummary = null; showReflection = false; teachCard = null; chapter = 0; ResetCounters();
        await Js("restart");
        if (!playing) { playing = true; await Js("setPlaying", true); }
    }

    private async Task RestartWithOtherComms()
    {
        comms = !comms;
        await Js("setComms", comms);
        await Restart();
    }

    private async Task OnSpeed(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v))
        {
            speed = v;
            await Js("setSpeed", v);
        }
    }

    private async Task SetView(string v) { view = v; await Js("setView", v); }

    private async Task OnComms(ChangeEventArgs e)
    {
        comms = e.Value is bool b && b;
        await Js("setComms", comms);
    }

    private async Task Select(string key) { selected = Roles.Get(key); await Js("select", key); }
    private async Task CloseCard() { selected = null; await Js("select", ""); }

    // ---- callbacks from the JS engine ----
    [JSInvokable] public void OnCaption(string text, string ph) { caption = text; phase = ph; StateHasChanged(); }
    [JSInvokable] public void OnAgentClicked(string role) { selected = Roles.Get(role); StateHasChanged(); }
    [JSInvokable] public void OnPlayState(bool isPlaying) { playing = isPlaying; StateHasChanged(); }
    [JSInvokable] public void OnViewChanged(string v) { view = v; StateHasChanged(); }
    private void ResetCounters() { wrongTurns = 0; surprises = 0; distractions = 0; priorities = 0; reported = 0; syncs = 0; ideas = 0; day = 1; }
    [JSInvokable] public void OnRestarted() { finishedSummary = null; showReflection = false; teachCard = null; chapter = 0; ResetCounters(); StateHasChanged(); }
    [JSInvokable] public void OnChapter(int i) { chapter = Math.Clamp(i, 0, Chapters.All.Count - 1); StateHasChanged(); }
    [JSInvokable] public void OnTeachable(int i) { teachCard = Math.Clamp(i, 0, Chapters.All.Count - 1); playing = false; StateHasChanged(); }
    [JSInvokable]
    public async Task OnShortcut(string key)
    {
        switch (key)
        {
            case "chapters": showChapters = !showChapters; break;
            case "next": await NextChapter(); break;
            case "mute": await ToggleSound(); break;
            case "escape": showChapters = false; break;
        }
        StateHasChanged();
    }
    [JSInvokable] public void OnDay(int d) { day = d; StateHasChanged(); }
    [JSInvokable] public void OnStats(int wrong, int surprised, int distracted, int filtered, int reportedUp, int managerSyncs, int teamIdeas) { wrongTurns = wrong; surprises = surprised; distractions = distracted; priorities = filtered; reported = reportedUp; syncs = managerSyncs; ideas = teamIdeas; StateHasChanged(); }

    [JSInvokable]
    public void OnFinished(int seconds, int days, int wrong, int surprised, int distracted, int filtered, int reportedUp, int managerSyncs, int teamIdeas, int breaks, bool withComms)
    {
        wrongTurns = wrong; surprises = surprised; distractions = distracted; priorities = filtered; reported = reportedUp; syncs = managerSyncs; ideas = teamIdeas;
        showReflection = false;
        day = days; lastDays = days;
        if (withComms) daysOn = days; else daysOff = days;
        var mins = seconds / 60; var secs = seconds % 60;
        var runTime = $"({mins}:{secs:00} at 1× speed)";
        string compare;
        if (withComms)
        {
            var off = daysOff ?? TypicalDaysOff;
            var src = daysOff is null ? "usually takes about" : "took";
            compare = off > days
                ? $" Without communication the same project {src} {off} days: {off - days} days lost. Try it with communication OFF and compare!"
                : " Try it with communication OFF and compare!";
        }
        else
        {
            var on = daysOn ?? TypicalDaysOn;
            var src = daysOn is null ? "usually takes about" : "took";
            compare = days > on
                ? $" With the Manager communicating, the same project {src} {on} days: that's {days - on} days lost to missing information."
                : "";
        }
        var people = withComms
            ? $" Kip led the bridge build, Wattle was coached, Matilda was Koala of the week, Banjo's creek idea was adopted ({teamIdeas} team idea{(teamIdeas == 1 ? "" : "s")}), and {breaks} short break{(breaks == 1 ? "" : "s")} kept the pace sustainable. At the build site they used every skill from the journey, the owl supported without taking over, and the Leader's vision became the real pyramid."
            : " Banjo's ideas never reached anyone, nobody coached Wattle, and with no break the koalas finished exhausted. Nobody shared the vision, so a whole course of the pyramid had to be torn down and rebuilt.";
        finishedSummary = withComms
            ? $"With the Manager communicating, the koalas built the pyramid and delivered on day {days} {runTime}: {surprised} unwarned obstacles, {wrong} wrong turns and {reportedUp} surprises reported up and handled together. The Leader filtered {filtered} competing priorities, the Manager held {managerSyncs} manager syncs, and they shook off {distracted} distractions.{people}{compare}"
            : $"Without communication, the koalas took {days} days {runTime}, hit {surprised} unwarned obstacles, made {wrong} wrong turns, and faced every surprise alone (0 reported up).{people}{compare} Same forest, same koalas: the difference is the information they had.";
        reflection = withComms
            ? new[]
            {
                "At the build site the koalas used every skill they had built on the journey: gathering, hammer and chisel, planks, ropes, ladders, teamwork. Which skills has your team built recently, and which deliverable will they make possible?",
                "The owl organised the build, brought stone where it was needed and relayed progress up, but never took over. Where is the line between supporting the work and taking it over?",
                "The Leader held the vision, said \"After the launch!\" to one last request, and the team made it real. How clear is your team's picture of the final product?"
            }
            : new[]
            {
                "Nobody shared the vision, so the koalas built a whole course the wrong shape and had to redo it (\"Wait, was it meant to be pointy?\"). Where has your team rebuilt something because the end product wasn't clear?",
                "Nobody coached Wattle, Banjo's ideas went nowhere, and nobody organised the build. What happens in your team when no one supports the work?",
                "The koalas never got a break and slowed right down. Where is your team running without breaks, and what is it costing?"
            };
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (module is not null)
            {
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        selfRef?.Dispose();
    }
}
